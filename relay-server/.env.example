# DOM Mail Relay Server Configuration
# Copy this to .env and fill in your SMTP credentials

# Server
PORT=8765
RELAY_SECRET=your-secret-change-in-production

# SMTP Configuration (required for outbound mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Optional: DKIM signing
# DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# DKIM_DOMAIN=yourdomain.com
# DKIM_SELECTOR=default

# Optional: Rate limiting
# RATE_LIMIT=5
# RATE_DELTA=1000